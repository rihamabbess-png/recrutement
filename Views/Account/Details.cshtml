@model List<JobApplication>
@{
    ViewData["Title"] = "Candidatures";
    var currentStatus = ViewBag.Status as ApplicationStatus?;
}

@functions {
    string Libelle(ApplicationStatus s) => s switch
    {
        ApplicationStatus.EnAnalyse => "En analyse",
        ApplicationStatus.Analysee => "Analysée",
        ApplicationStatus.Entrevue => "Entrevue",
        ApplicationStatus.Retenue => "Retenue",
        ApplicationStatus.Refusee => "Refusée",
        _ => s.ToString()
    };
}

<div class="page-title">
    <h2 class="m-0">Candidatures</h2>
</div>

<div class="card">
    <div class="card-body-pad">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">Filtrer par statut</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">Tous</option>
                    @foreach (var s in Enum.GetValues<ApplicationStatus>())
                    {
                        <option value="@s" selected="@(currentStatus == s)">@Libelle(s)</option>
                    }
                </select>
            </div>
        </form>

        <table class="table align-middle m-0">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Offre</th>
                    <th>Score IA</th>
                    <th>Salaire attendu / Budget</th>
                    <th>Statut</th>
                    <th>CV</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>@app.FullName</td>
                    <td>@app.JobOffer?.Title</td>
                    <td>
                        @if (app.AiScore is not null)
                        {
                            <span class="badge bg-primary">@app.AiScore / 100</span>
                        }
                        else if (app.AiError is not null)
                        {
                            <span class="badge bg-danger">Erreur</span>
                        }
                        else
                        {
                            <span class="text-muted">En attente</span>
                        }
                    </td>
                    <td>
                        @app.ExpectedSalary.ToString("N0") $
                        <div class="small text-muted">
                            Offre : @app.JobOffer?.BudgetMin.ToString("N0") $ à @app.JobOffer?.BudgetMax.ToString("N0") $
                        </div>
                        @if (app.AiBudgetFit == true)
                        {
                            <span class="badge bg-success">Dans le budget</span>
                        }
                        else if (app.AiBudgetFit == false)
                        {
                            <span class="badge bg-warning text-dark">Hors budget</span>
                        }
                    </td>
                    <td>@Libelle(app.Status)</td>
                    <td>
                        <a asp-action="Cv" asp-route-id="@app.Id" target="_blank"
                           class="btn btn-outline-secondary btn-sm">Ouvrir</a>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@app.Id"
                           class="btn btn-outline-secondary btn-sm">Voir</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="text-muted mt-3 mb-0">Aucune candidature pour l'instant.</p>
        }
    </div>
</div>
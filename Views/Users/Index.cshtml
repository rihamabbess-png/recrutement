@model List<(Recrutement.Models.ApplicationUser User, IList<string> Roles)>
@{
    ViewData["Title"] = "Utilisateurs";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="page-title">
    <h2 class="m-0">Utilisateurs</h2>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["NewUserPassword"] is string newPassword)
{
    <div class="alert alert-success">
        <strong>Mot de passe généré pour @TempData["NewUserEmail"] :</strong>
        <code class="fs-5">@newPassword</code>
        <div class="small mt-2">Notez-le maintenant. Il ne sera plus affiché.</div>
    </div>
}

<div class="card">
    <div class="card-body-pad">
        <h5 class="mb-3">Créer un compte</h5>
        <form asp-action="Create" method="post" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="fullName">Nom complet</label>
                <input id="fullName" name="fullName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="email">Courriel</label>
                <input id="email" name="email" type="email" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="role">Rôle</label>
                <select id="role" name="role" class="form-select">
                    <option value="RH">RH</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Créer</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body-pad">
        <table class="table align-middle m-0">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Courriel</th>
                    <th>Rôle</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.User.FullName
                        @if (item.User.Id == currentUserId)
                        {
                            <span class="badge bg-secondary ms-1">Vous</span>
                        }
                    </td>
                    <td>@item.User.Email</td>
                    <td>@string.Join(", ", item.Roles)</td>
                    <td class="text-end">
                        <form asp-action="ResetPassword" asp-route-id="@item.User.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Réinitialiser</button>
                        </form>
                        @if (item.User.Id != currentUserId)
                        {
                            <form asp-action="Delete" asp-route-id="@item.User.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Supprimer ce compte ? Ses offres vous seront réassignées.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>